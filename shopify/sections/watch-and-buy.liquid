{% comment %}
  Watch & Buy — 3D video carousel + click-to-open video popup
  Horizontally scrolling 9:16 video cards with a 3D coverflow effect,
  soft rounded borders, and a tappable product tag on each video.
  Clicking a card opens a lightbox: the video plays with sound + controls
  and the tagged product appears as a Shop button.
  Add one block per video. Fully editable in the theme editor.
{% endcomment %}

{%- liquid
  assign side_scale = section.settings.side_scale | divided_by: 100.0

  assign snap_align = 'start'
  if section.settings.carousel_alignment == 'center'
    assign snap_align = 'center'
  endif
-%}

{%- style -%}
  #watch-buy-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #watch-buy-{{ section.id }} .wb__heading {
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.heading_alignment }};
    text-transform: {{ section.settings.heading_uppercase }};
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    padding: 0 16px;
  }

  #watch-buy-{{ section.id }} .wb__wrap {
    position: relative;
  }

  #watch-buy-{{ section.id }} .wb__track {
    --card-w: {{ section.settings.card_width_mobile }}px;
    display: flex;
    gap: {{ section.settings.gap_mobile }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    {%- if section.settings.carousel_alignment == 'center' %}
    padding: 24px calc(50% - var(--card-w) / 2);
    {%- else %}
    padding: 24px {{ section.settings.side_padding }}px;
    scroll-padding-left: {{ section.settings.side_padding }}px;
    {%- endif %}
    scrollbar-width: none;
  }
  #watch-buy-{{ section.id }} .wb__track::-webkit-scrollbar { display: none; }

  #watch-buy-{{ section.id }} .wb__card {
    position: relative;
    flex: 0 0 var(--card-w);
    width: var(--card-w);
    aspect-ratio: 9 / 16;
    scroll-snap-align: {{ snap_align }};
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    transition: transform 0.25s ease-out;
    will-change: transform;
    {%- if section.settings.enable_popup %}cursor: pointer;{%- endif %}
  }

  @supports not (aspect-ratio: 9 / 16) {
    #watch-buy-{{ section.id }} .wb__card { height: calc(var(--card-w) * 16 / 9); }
  }

  #watch-buy-{{ section.id }} .wb__video,
  #watch-buy-{{ section.id }} .wb__card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #watch-buy-{{ section.id }} .wb__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2a2a2a, #4a4a4a);
    color: #ffffff;
  }
  #watch-buy-{{ section.id }} .wb__placeholder svg { width: 48px; height: 48px; opacity: 0.7; }

  #watch-buy-{{ section.id }} .wb__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 60%, rgba(0,0,0,0.45) 100%);
    pointer-events: none;
  }

  #watch-buy-{{ section.id }} .wb__mute {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 4;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  #watch-buy-{{ section.id }} .wb__mute svg { width: 16px; height: 16px; fill: currentColor; }
  #watch-buy-{{ section.id }} .wb__mute .wb__icon-on { display: none; }
  #watch-buy-{{ section.id }} .wb__mute.is-on .wb__icon-on { display: block; }
  #watch-buy-{{ section.id }} .wb__mute.is-on .wb__icon-off { display: none; }

  {%- if section.settings.enable_popup -%}
  #watch-buy-{{ section.id }} .wb__expand {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 4;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: none;
  }
  #watch-buy-{{ section.id }} .wb__expand svg { width: 15px; height: 15px; fill: currentColor; }
  {%- endif -%}

  {%- if section.settings.show_product_tag -%}
  #watch-buy-{{ section.id }} .wb__product {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 10px;
    background: {{ section.settings.tag_bg_color }};
    color: {{ section.settings.tag_text_color }};
    border-radius: {{ section.settings.corner_radius | at_most: 14 }}px;
    padding: 8px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
  }
  #watch-buy-{{ section.id }} .wb__product-img {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }
  #watch-buy-{{ section.id }} .wb__product-info { min-width: 0; }
  #watch-buy-{{ section.id }} .wb__product-title {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: {{ section.settings.tag_text_color }};
  }
  #watch-buy-{{ section.id }} .wb__product-price {
    margin: 2px 0 0;
    font-size: 0.74rem;
    opacity: 0.8;
    color: {{ section.settings.tag_text_color }};
  }
  {%- endif -%}

  #watch-buy-{{ section.id }} .wb__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_icon_color }};
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    transition: opacity 0.2s ease;
  }
  #watch-buy-{{ section.id }} .wb__arrow:hover { opacity: 0.85; }
  #watch-buy-{{ section.id }} .wb__arrow svg { width: 18px; height: 18px; }
  #watch-buy-{{ section.id }} .wb__arrow--prev { left: 14px; }
  #watch-buy-{{ section.id }} .wb__arrow--next { right: 14px; }

  @media screen and (min-width: 750px) {
    #watch-buy-{{ section.id }} .wb__track {
      --card-w: {{ section.settings.card_width }}px;
      gap: {{ section.settings.gap_desktop }}px;
    }
    {%- if section.settings.show_arrows -%}
    #watch-buy-{{ section.id }} .wb__arrow { display: flex; }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce) {
    #watch-buy-{{ section.id }} .wb__card { transition: none; transform: none !important; }
  }

  /* ---------- Video popup / lightbox ---------- */
  #watch-buy-{{ section.id }} .wb__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  #watch-buy-{{ section.id }} .wb__modal.is-open { display: flex; }
  #watch-buy-{{ section.id }} .wb__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  #watch-buy-{{ section.id }} .wb__modal-dialog {
    position: relative;
    width: min(420px, 92vw);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    z-index: 1;
    animation: wbPop 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  @keyframes wbPop {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  #watch-buy-{{ section.id }} .wb__modal-media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #000;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
  }
  #watch-buy-{{ section.id }} .wb__modal-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }
  #watch-buy-{{ section.id }} .wb__modal-footer {
    background: {{ section.settings.popup_footer_bg }};
    border-radius: 0 0 16px 16px;
    padding: 12px;
  }
  #watch-buy-{{ section.id }} .wb__modal-footer:empty { display: none; }
  #watch-buy-{{ section.id }} .wb__modal-product {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  #watch-buy-{{ section.id }} .wb__modal-pimg {
    width: 54px;
    height: 54px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
  }
  #watch-buy-{{ section.id }} .wb__modal-pinfo { flex: 1; min-width: 0; }
  #watch-buy-{{ section.id }} .wb__modal-ptitle {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    color: {{ section.settings.popup_text_color }};
  }
  #watch-buy-{{ section.id }} .wb__modal-pprice {
    margin: 3px 0 0;
    font-size: 0.85rem;
    opacity: 0.85;
    color: {{ section.settings.popup_text_color }};
  }
  #watch-buy-{{ section.id }} .wb__modal-buy {
    flex-shrink: 0;
    background: {{ section.settings.popup_button_bg }};
    color: {{ section.settings.popup_button_text_color }};
    padding: 11px 24px;
    border-radius: 26px;
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  #watch-buy-{{ section.id }} .wb__modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fff;
    color: #121212;
    border: none;
    cursor: pointer;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }
  #watch-buy-{{ section.id }} .wb__modal-close svg { width: 16px; height: 16px; fill: currentColor; }
  @media screen and (max-width: 767px) {
    #watch-buy-{{ section.id }} .wb__modal-close { top: -10px; right: 2px; }
  }
{%- endstyle -%}

<div id="watch-buy-{{ section.id }}" data-wb-section data-tilt="{{ section.settings.tilt }}" data-side-scale="{{ side_scale }}" data-popup="{{ section.settings.enable_popup }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="wb__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="wb__wrap">
    <button type="button" class="wb__arrow wb__arrow--prev" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="wb__track" data-wb-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign prod = block.settings.product
          assign has_video = false
          if block.settings.video != blank or block.settings.video_url_mp4 != blank
            assign has_video = true
          endif
        -%}
        <div class="wb__card" data-wb-card data-has-video="{{ has_video }}" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            <video
              class="wb__video"
              muted
              loop
              playsinline
              preload="metadata"
              {% if block.settings.video.preview_image %}poster="{{ block.settings.video.preview_image | image_url: width: 600 }}"{% endif %}
            >
              {%- for source in block.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif block.settings.video_url_mp4 != blank -%}
            <video class="wb__video" muted loop playsinline preload="metadata" src="{{ block.settings.video_url_mp4 }}"></video>
          {%- else -%}
            <div class="wb__placeholder">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          {%- endif -%}

          <span class="wb__shade"></span>

          {%- if section.settings.enable_popup and has_video -%}
            <span class="wb__expand" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
            </span>
          {%- endif -%}

          {%- if has_video -%}
            <button type="button" class="wb__mute" aria-label="Toggle sound">
              <svg class="wb__icon-off" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3l3-3-1.4-1.4-3 3-3-3L10.7 9l3 3-3 3 1.4 1.4 3-3 3 3 1.4-1.4-3-3z"/></svg>
              <svg class="wb__icon-on" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.8-1-3.3-2.5-4v8c1.5-.7 2.5-2.2 2.5-4zM14 3.2v2.1c2.9.9 5 3.5 5 6.7s-2.1 5.8-5 6.7v2.1c4-.9 7-4.5 7-8.8s-3-7.9-7-8.8z"/></svg>
            </button>
          {%- endif -%}

          {%- if section.settings.show_product_tag and prod != blank -%}
            <a class="wb__product" href="{{ prod.url }}" data-wb-tag>
              {%- if prod.featured_image -%}
                <img
                  class="wb__product-img"
                  src="{{ prod.featured_image | image_url: width: 100 }}"
                  alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                  loading="lazy"
                  width="42"
                  height="42"
                >
              {%- endif -%}
              <span class="wb__product-info">
                <p class="wb__product-title">{{ block.settings.custom_label | default: prod.title }}</p>
                {%- if section.settings.show_price -%}
                  <p class="wb__product-price">
                    {%- if prod.compare_at_price > prod.price -%}
                      <s style="opacity:0.6;">{{ prod.compare_at_price | money }}</s>
                    {%- endif %}
                    {{ prod.price | money }}
                  </p>
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}

          {%- comment -%} Popup content (cloned into the lightbox on click) {%- endcomment -%}
          {%- if section.settings.enable_popup and has_video -%}
            <template data-wb-tpl>
              {%- if block.settings.video != blank -%}
                <video class="wb__modal-video" controls autoplay playsinline preload="none"
                  {% if block.settings.video.preview_image %}poster="{{ block.settings.video.preview_image | image_url: width: 900 }}"{% endif %}>
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif block.settings.video_url_mp4 != blank -%}
                <video class="wb__modal-video" controls autoplay playsinline preload="none" src="{{ block.settings.video_url_mp4 }}"></video>
              {%- endif -%}

              {%- if prod != blank -%}
                <a class="wb__modal-product" href="{{ prod.url }}">
                  {%- if prod.featured_image -%}
                    <img class="wb__modal-pimg" src="{{ prod.featured_image | image_url: width: 160 }}" alt="{{ prod.title | escape }}" width="54" height="54">
                  {%- endif -%}
                  <span class="wb__modal-pinfo">
                    <p class="wb__modal-ptitle">{{ block.settings.custom_label | default: prod.title }}</p>
                    {%- if section.settings.show_price -%}
                      <p class="wb__modal-pprice">
                        {%- if prod.compare_at_price > prod.price -%}<s style="opacity:0.6;">{{ prod.compare_at_price | money }}</s> {% endif %}{{ prod.price | money }}
                      </p>
                    {%- endif -%}
                  </span>
                  <span class="wb__modal-buy">{{ section.settings.popup_button_text | default: 'Shop Now' }}</span>
                </a>
              {%- endif -%}
            </template>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <button type="button" class="wb__arrow wb__arrow--next" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>

  {%- if section.settings.enable_popup -%}
    <div class="wb__modal" data-wb-modal aria-hidden="true">
      <div class="wb__modal-backdrop" data-wb-close></div>
      <div class="wb__modal-dialog" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | default: 'Video' | escape }}">
        <button class="wb__modal-close" type="button" data-wb-close aria-label="Close">
          <svg viewBox="0 0 24 24"><path d="M18.3 5.71L12 12l6.3 6.29-1.42 1.42L10.59 13.4l-6.3 6.3-1.41-1.42L9.17 12 2.88 5.71 4.29 4.3l6.3 6.3 6.29-6.3z"/></svg>
        </button>
        <div class="wb__modal-media" data-wb-modal-media></div>
        <div class="wb__modal-footer" data-wb-modal-footer></div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    function initWatchBuy(root) {
      var track = root.querySelector('[data-wb-track]');
      if (!track) return;
      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-wb-card]'));
      var tilt = parseFloat(root.getAttribute('data-tilt')) || 0;
      var sideScale = parseFloat(root.getAttribute('data-side-scale')) || 0.85;
      var popupOn = root.getAttribute('data-popup') === 'true';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ticking = false;

      /* --- 3D coverflow: tilt + scale based on distance from center --- */
      function update3d() {
        ticking = false;
        if (reduced) return;
        var rect = track.getBoundingClientRect();
        var center = rect.left + rect.width / 2;
        cards.forEach(function (card) {
          var r = card.getBoundingClientRect();
          var d = (r.left + r.width / 2 - center) / (rect.width / 2);
          if (d > 1) d = 1;
          if (d < -1) d = -1;
          var scale = 1 - Math.abs(d) * (1 - sideScale);
          card.style.transform =
            'perspective(1200px) rotateY(' + (-d * tilt).toFixed(2) + 'deg) scale(' + scale.toFixed(3) + ')';
          card.style.zIndex = String(100 - Math.round(Math.abs(d) * 50));
        });
      }
      function onScroll() {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update3d);
        }
      }
      track.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update3d();

      /* --- autoplay inline videos only while visible --- */
      var autoplayInline = {% if section.settings.autoplay %}true{% else %}false{% endif %};
      if (autoplayInline) {
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              var v = entry.target.querySelector('.wb__video');
              if (!v) return;
              if (entry.isIntersecting) { v.play().catch(function () {}); }
              else { v.pause(); }
            });
          }, { root: null, threshold: 0.35 });
          cards.forEach(function (c) { io.observe(c); });
        } else {
          cards.forEach(function (c) {
            var v = c.querySelector('.wb__video');
            if (v) v.play().catch(function () {});
          });
        }
      }

      /* --- mute toggle (does not open popup) --- */
      root.querySelectorAll('.wb__mute').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var v = btn.closest('[data-wb-card]').querySelector('.wb__video');
          if (!v) return;
          v.muted = !v.muted;
          btn.classList.toggle('is-on', !v.muted);
          if (!v.muted) v.play().catch(function () {});
        });
      });

      /* --- product tag stays a direct link, doesn't open popup --- */
      root.querySelectorAll('[data-wb-tag]').forEach(function (tag) {
        tag.addEventListener('click', function (e) { e.stopPropagation(); });
      });

      /* --- video popup --- */
      var modal = root.querySelector('[data-wb-modal]');
      var modalMedia = modal ? modal.querySelector('[data-wb-modal-media]') : null;
      var modalFooter = modal ? modal.querySelector('[data-wb-modal-footer]') : null;

      function openModal(card) {
        if (!modal) return;
        var tpl = card.querySelector('[data-wb-tpl]');
        modalMedia.innerHTML = '';
        modalFooter.innerHTML = '';
        if (tpl) {
          var frag = tpl.content.cloneNode(true);
          var vid = frag.querySelector('video');
          var buy = frag.querySelector('.wb__modal-product');
          if (vid) modalMedia.appendChild(vid);
          if (buy) modalFooter.appendChild(buy);
        }
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        cards.forEach(function (c) { var v = c.querySelector('.wb__video'); if (v) v.pause(); });
      }
      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        modalMedia.innerHTML = ''; // stops the popup video
        document.body.style.overflow = '';
        if (autoplayInline) {
          cards.forEach(function (c) { var v = c.querySelector('.wb__video'); if (v) v.play().catch(function () {}); });
        }
      }
      if (modal) {
        modal.querySelectorAll('[data-wb-close]').forEach(function (el) {
          el.addEventListener('click', closeModal);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
        });
      }

      /* --- distinguish a tap from a swipe so dragging the carousel doesn't open the popup --- */
      var downX = 0, downY = 0, moved = false;
      track.addEventListener('pointerdown', function (e) { downX = e.clientX; downY = e.clientY; moved = false; }, { passive: true });
      track.addEventListener('pointermove', function (e) {
        if (Math.abs(e.clientX - downX) > 10 || Math.abs(e.clientY - downY) > 10) moved = true;
      }, { passive: true });

      if (popupOn) {
        cards.forEach(function (card) {
          card.addEventListener('click', function () {
            if (moved) return;
            if (card.getAttribute('data-has-video') !== 'true') return;
            openModal(card);
          });
        });
      }

      /* --- arrows --- */
      function step() {
        var card = cards[0];
        if (!card) return 300;
        return card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).gap || 16);
      }
      var prev = root.querySelector('.wb__arrow--prev');
      var next = root.querySelector('.wb__arrow--next');
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    }

    function boot() {
      var el = document.getElementById('watch-buy-{{ section.id }}');
      if (el) initWatchBuy(el);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    /* --- theme editor support --- */
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.querySelector && e.target.querySelector('#watch-buy-{{ section.id }}')) boot();
    });
    document.addEventListener('shopify:block:select', function (e) {
      var card = e.target;
      if (card && card.closest && card.closest('#watch-buy-{{ section.id }}')) {
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });
  })();
</script>

