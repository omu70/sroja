{% comment %}
  Libas-style Header
  Layout: [hamburger + search] — [centered logo] — [account / wishlist / cart]
  Optional purple top bar, sticky option, transparent-over-hero option.
  Self-contained: own drawer menu + search panel (no theme JS dependencies).
  Typography inherits the theme's default fonts (no font-family overrides).
{% endcomment %}

{%- liquid
  assign transparent_active = false
  if section.settings.enable_transparent
    if section.settings.transparent_home_only
      if template.name == 'index'
        assign transparent_active = true
      endif
    else
      assign transparent_active = true
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    z-index: 90;
    position: relative;
    {% if transparent_active %}
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .lh-topbar {
    display: block;
    background: {{ section.settings.topbar_bg }};
    color: {{ section.settings.topbar_text_color }};
    text-align: center;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    {% if section.settings.topbar_text != blank %}
    padding: 8px 15px;
    {% else %}
    height: {{ section.settings.topbar_height }}px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .lh-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    padding: {{ section.settings.bar_padding }}px 30px;
    background: {{ section.settings.header_bg }};
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .lh-bar { padding: {{ section.settings.bar_padding }}px 15px; }
  }
  #shopify-section-{{ section.id }} .lh-left,
  #shopify-section-{{ section.id }} .lh-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .lh-right { justify-content: flex-end; }
  #shopify-section-{{ section.id }} .lh-iconbtn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: {{ section.settings.icon_color }};
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.3s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lh-iconbtn:hover { opacity: 0.65; }
  #shopify-section-{{ section.id }} .lh-iconbtn svg {
    width: 23px;
    height: 23px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .lh-label { display: none; }
  }
  #shopify-section-{{ section.id }} .lh-logo {
    text-decoration: none;
    display: inline-flex;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .lh-logo img {
    max-width: min({{ section.settings.logo_max_width }}px, 44vw);
    height: auto;
    display: block;
  }
  #shopify-section-{{ section.id }} .lh-logo-text {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: bold;
    letter-spacing: 0.04em;
    color: {{ section.settings.logo_text_color }};
    transition: color 0.3s ease;
  }
  #shopify-section-{{ section.id }} .lh-logo img.lh-logo--transparent { display: none; }
  #shopify-section-{{ section.id }} .lh-cart { position: relative; }
  #shopify-section-{{ section.id }} .lh-cart-count {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    background: {{ section.settings.icon_color }};
    color: {{ section.settings.header_bg }};
    font-size: 10px;
    line-height: 16px;
    text-align: center;
    padding: 0 4px;
    transition: background 0.3s ease, color 0.3s ease;
  }

  /* ----- Fixed (sticky) state ----- */
  #shopify-section-{{ section.id }} .lh-bar.lh--fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 95;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    animation: lhSlideDown 0.25s ease;
  }
  @keyframes lhSlideDown {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  /* ----- Transparent state ----- */
  {% if transparent_active %}
  #shopify-section-{{ section.id }} .lh-bar:not(.lh--fixed) {
    background: transparent;
  }
  #shopify-section-{{ section.id }} .lh-bar:not(.lh--fixed) .lh-iconbtn,
  #shopify-section-{{ section.id }} .lh-bar:not(.lh--fixed) .lh-logo-text {
    color: {{ section.settings.transparent_color }};
  }
  #shopify-section-{{ section.id }} .lh-bar:not(.lh--fixed) .lh-cart-count {
    background: {{ section.settings.transparent_color }};
    color: rgba(0, 0, 0, 0.75);
  }
  {% if section.settings.logo_transparent %}
  #shopify-section-{{ section.id }} .lh-bar:not(.lh--fixed) img.lh-logo--default { display: none; }
  #shopify-section-{{ section.id }} .lh-bar:not(.lh--fixed) img.lh-logo--transparent { display: block; }
  {% endif %}
  {% endif %}

  /* ----- Drawer menu ----- */
  #shopify-section-{{ section.id }} .lh-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 98;
  }
  #shopify-section-{{ section.id }} .lh-backdrop.is-open { opacity: 1; visibility: visible; }
  #shopify-section-{{ section.id }} .lh-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(340px, 88vw);
    background: {{ section.settings.drawer_bg }};
    color: {{ section.settings.drawer_text }};
    z-index: 99;
    transform: translateX(-105%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    padding: 18px 0 40px;
  }
  #shopify-section-{{ section.id }} .lh-drawer.is-open { transform: translateX(0); }
  #shopify-section-{{ section.id }} .lh-drawer-head {
    display: flex;
    justify-content: flex-end;
    padding: 0 12px 8px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  #shopify-section-{{ section.id }} .lh-drawer a,
  #shopify-section-{{ section.id }} .lh-drawer .lh-subtoggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 22px;
    background: none;
    border: none;
    color: inherit;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .lh-drawer a:hover,
  #shopify-section-{{ section.id }} .lh-drawer .lh-subtoggle:hover { opacity: 0.65; }
  #shopify-section-{{ section.id }} .lh-subtoggle svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    transition: transform 0.25s ease;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .lh-subtoggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .lh-sub { display: none; }
  #shopify-section-{{ section.id }} .lh-sub.is-open { display: block; }
  #shopify-section-{{ section.id }} .lh-sub a,
  #shopify-section-{{ section.id }} .lh-sub .lh-subtoggle {
    padding-left: 38px;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0.03em;
  }
  #shopify-section-{{ section.id }} .lh-sub .lh-sub a { padding-left: 54px; }

  /* ----- Search panel ----- */
  #shopify-section-{{ section.id }} .lh-search {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: {{ section.settings.header_bg }};
    z-index: 99;
    transform: translateY(-105%);
    transition: transform 0.3s ease;
    padding: 26px 20px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
  }
  #shopify-section-{{ section.id }} .lh-search.is-open { transform: translateY(0); }
  #shopify-section-{{ section.id }} .lh-search form {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .lh-search input[type="search"] {
    flex: 1;
    border: none;
    border-bottom: 1px solid {{ section.settings.icon_color }};
    background: transparent;
    color: {{ section.settings.icon_color }};
    font-size: 16px;
    padding: 10px 4px;
    outline: none;
    border-radius: 0;
  }
{%- endstyle -%}

<libas-header
  id="LibasHeader-{{ section.id }}"
  data-transparent="{{ transparent_active }}"
  data-sticky="{{ section.settings.enable_sticky }}"
>
  {%- if section.settings.show_topbar -%}
    {%- if section.settings.topbar_link != blank -%}
      <a class="lh-topbar" href="{{ section.settings.topbar_link }}">{{ section.settings.topbar_text | escape }}</a>
    {%- else -%}
      <div class="lh-topbar">{{ section.settings.topbar_text | escape }}</div>
    {%- endif -%}
  {%- endif -%}

  <div class="lh-bar">
    <div class="lh-left">
      <button class="lh-iconbtn lh-menu-open" type="button" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        {%- if section.settings.show_labels -%}<span class="lh-label">Menu</span>{%- endif -%}
      </button>
      {%- if section.settings.show_search -%}
        <button class="lh-iconbtn lh-search-open" type="button" aria-label="Open search" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          {%- if section.settings.show_labels -%}<span class="lh-label">Search</span>{%- endif -%}
        </button>
      {%- endif -%}
    </div>

    <a class="lh-logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        <img
          class="lh-logo--default"
          src="{{ section.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="eager"
        >
        {%- if transparent_active and section.settings.logo_transparent -%}
          <img
            class="lh-logo--transparent"
            src="{{ section.settings.logo_transparent | image_url: width: 600 }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_transparent.width }}"
            height="{{ section.settings.logo_transparent.height }}"
            loading="eager"
          >
        {%- endif -%}
      {%- else -%}
        <span class="lh-logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="lh-right">
      {%- if section.settings.show_contact and section.settings.contact_text != blank -%}
        <a class="lh-iconbtn" href="{{ section.settings.contact_link | default: '/pages/contact-us' }}">
          <span class="lh-label">{{ section.settings.contact_text | escape }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.show_account -%}
        <a class="lh-iconbtn" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20.5c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.show_wishlist -%}
        <a class="lh-iconbtn" href="{{ section.settings.wishlist_url | default: '/account' }}" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5l-7.2-7.1a4.8 4.8 0 010-6.9 5 5 0 017 0l.2.2.2-.2a5 5 0 017 0 4.8 4.8 0 010 6.9z"/></svg>
        </a>
      {%- endif -%}
      <a class="lh-iconbtn lh-cart" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12.5H6z"/><path d="M9 10V6.5a3 3 0 016 0V10"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="lh-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- if section.settings.show_search -%}
    <div class="lh-search" role="dialog" aria-label="Search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true" style="width:20px;height:20px;stroke:{{ section.settings.icon_color }};fill:none;stroke-width:1.5;"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
        <input type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="Search">
        <input type="hidden" name="options[prefix]" value="last">
        <button class="lh-iconbtn lh-search-close" type="button" aria-label="Close search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
        </button>
      </form>
    </div>
  {%- endif -%}

  <div class="lh-backdrop"></div>

  <aside class="lh-drawer" role="dialog" aria-label="Menu">
    <div class="lh-drawer-head">
      <button class="lh-iconbtn lh-menu-close" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
    </div>
    <nav>
      {%- for link in linklists[section.settings.main_menu].links -%}
        {%- if link.links != blank -%}
          <button class="lh-subtoggle" type="button" aria-expanded="false">
            {{ link.title | escape }}
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="5 9 12 16 19 9"/></svg>
          </button>
          <div class="lh-sub">
            {%- for childlink in link.links -%}
              {%- if childlink.links != blank -%}
                <button class="lh-subtoggle" type="button" aria-expanded="false">
                  {{ childlink.title | escape }}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="5 9 12 16 19 9"/></svg>
                </button>
                <div class="lh-sub">
                  {%- for grandchildlink in childlink.links -%}
                    <a href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </aside>
</libas-header>

<script>
  if (!customElements.get('libas-header')) {
    class LibasHeader extends HTMLElement {
      connectedCallback() {
        this.bar = this.querySelector('.lh-bar');
        this.drawer = this.querySelector('.lh-drawer');
        this.backdrop = this.querySelector('.lh-backdrop');
        this.search = this.querySelector('.lh-search');
        this.placeholder = null;
        this.transparent = this.dataset.transparent === 'true';
        this.sticky = this.dataset.sticky === 'true';

        var self = this;
        var openBtn = this.querySelector('.lh-menu-open');
        var closeBtn = this.querySelector('.lh-menu-close');
        if (openBtn) openBtn.addEventListener('click', function () { self.toggleDrawer(true); });
        if (closeBtn) closeBtn.addEventListener('click', function () { self.toggleDrawer(false); });
        if (this.backdrop) this.backdrop.addEventListener('click', function () {
          self.toggleDrawer(false);
          self.toggleSearch(false);
        });

        var searchOpen = this.querySelector('.lh-search-open');
        var searchClose = this.querySelector('.lh-search-close');
        if (searchOpen) searchOpen.addEventListener('click', function () { self.toggleSearch(true); });
        if (searchClose) searchClose.addEventListener('click', function () { self.toggleSearch(false); });

        this.querySelectorAll('.lh-subtoggle').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!expanded));
            var sub = btn.nextElementSibling;
            if (sub) sub.classList.toggle('is-open', !expanded);
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            self.toggleDrawer(false);
            self.toggleSearch(false);
          }
        });

        if (this.sticky) {
          this.stickyOffset = this.transparent
            ? 80
            : this.bar.getBoundingClientRect().top + window.scrollY;
          window.addEventListener('scroll', this.onScroll.bind(this), { passive: true });
          this.onScroll();
        }
      }
      onScroll() {
        if (this._raf) return;
        var self = this;
        this._raf = requestAnimationFrame(function () {
          self._raf = null;
          var fix = window.scrollY > Math.max(self.stickyOffset, 1) + self.bar.offsetHeight;
          if (fix === self._fixed) return;
          self._fixed = fix;
          self.bar.classList.toggle('lh--fixed', fix);
          if (!self.transparent) {
            if (fix && !self.placeholder) {
              self.placeholder = document.createElement('div');
              self.placeholder.style.height = self.bar.offsetHeight + 'px';
              self.bar.parentNode.insertBefore(self.placeholder, self.bar);
            } else if (!fix && self.placeholder) {
              self.placeholder.remove();
              self.placeholder = null;
            }
          }
        });
      }
      toggleDrawer(open) {
        if (!this.drawer) return;
        this.drawer.classList.toggle('is-open', open);
        this.backdrop.classList.toggle('is-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
        var btn = this.querySelector('.lh-menu-open');
        if (btn) btn.setAttribute('aria-expanded', String(open));
      }
      toggleSearch(open) {
        if (!this.search) return;
        this.search.classList.toggle('is-open', open);
        if (open) {
          this.backdrop.classList.add('is-open');
          var input = this.search.querySelector('input[type="search"]');
          if (input) setTimeout(function () { input.focus(); }, 250);
        } else if (!this.drawer.classList.contains('is-open')) {
          this.backdrop.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      }
    }
    customElements.define('libas-header', LibasHeader);
  }
</script>

{% schema %}
{
  "name": "Libas Style Header",
  "tag": "header",
  "class": "lh-section",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Show top bar",
      "default": true
    },
    {
      "type": "text",
      "id": "topbar_text",
      "label": "Top bar text (optional)"
    },
    {
      "type": "url",
      "id": "topbar_link",
      "label": "Top bar link (optional)"
    },
    {
      "type": "range",
      "id": "topbar_height",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top bar height (when no text)",
      "default": 10
    },
    {
      "type": "color",
      "id": "topbar_bg",
      "label": "Top bar background",
      "default": "#72006A"
    },
    {
      "type": "color",
      "id": "topbar_text_color",
      "label": "Top bar text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo max width",
      "default": 130
    },
    {
      "type": "color",
      "id": "logo_text_color",
      "label": "Text logo color (no image)",
      "default": "#72006A"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show MENU / SEARCH text next to icons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search"
    },
    {
      "type": "header",
      "content": "Right side icons"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "text",
      "id": "wishlist_url",
      "label": "Wishlist link",
      "default": "/account",
      "info": "Point this to your wishlist app page if you install one."
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact link",
      "default": false
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact link text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link URL"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky header",
      "default": true,
      "info": "Header slides back in (solid) after scrolling down."
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "Transparent header",
      "default": false,
      "info": "Overlays the header on the first section. Works best over a full-width hero image."
    },
    {
      "type": "checkbox",
      "id": "transparent_home_only",
      "label": "Transparent on home page only",
