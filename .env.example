# ── SROJA Maison ───────────────────────────────────────────────
# Everything is optional. The site runs fully without any of these.

# PostgreSQL (Prisma) — only needed if you wire inquiries/products to a DB
# DATABASE_URL="postgresql://user:password@host:5432/sroja"

# Resend — transactional email for the private-consultation workflow
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# INQUIRY_TO_EMAIL="hello@sroja.in"
# INQUIRY_FROM_EMAIL="Maison SROJA <maison@sroja.in>"

# Cloudinary — optional asset pipeline for film/video assets
# NEXT_PUBLIC_CLOUDINARY_CLOUD="your-cloud"

# Public site URL (used for SEO/canonical/sitemap)
NEXT_PUBLIC_SITE_URL="https://sroja.in"
